@baseUrl = http://localhost:3000

### 9. Cadastrar vendedor 1 de 5
POST {{baseUrl}}/vendedores
Content-Type: application/json

{
  "nome": "Ana Lima",
  "metaMensal": 10000,
  "percentualBase": 5
}

